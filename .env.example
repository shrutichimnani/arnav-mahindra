# Set this to the site's real deployed Netlify URL (e.g. https://mahindra-modi.netlify.app
# or your custom domain) in Netlify's dashboard env variables. Used as metadataBase for
# resolving Open Graph/Twitter image URLs and as the canonical site URL.
NEXT_PUBLIC_SITE_URL=

# Google Apps Script web app URL for form submissions (server-only, no NEXT_PUBLIC_ prefix).
SHEET_SCRIPT_URL=

# SMS OTP delivery (alotsolutions.in). Put {OTP} in the message where the code goes;
# the text must match the DLT-registered template.
SMS_API_KEY=
SMS_DLT_TEMPLATE_ID=
SMS_MESSAGE_TEMPLATE=
